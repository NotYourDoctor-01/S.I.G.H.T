<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:background="@drawable/bg_item_file"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:padding="14dp">

    <ImageView
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:background="@drawable/bg_logo_chip"
        android:contentDescription="File icon"
        android:padding="10dp"
        android:scaleType="centerInside"
        app:srcCompat="@drawable/ic_folder" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/fileName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="recording_01.mp4"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/fileDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="Video recording"
            android:textColor="#9CA3AF"
            android:textSize="13sp" />

    </LinearLayout>

    <ImageView
        android:id="@+id/playIcon"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:contentDescription="Open file"
        android:padding="4dp"
        app:srcCompat="@drawable/ic_play" />

    <CheckBox
        android:id="@+id/fileCheck"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:buttonTint="@color/white"
        android:clickable="false"
        android:focusable="false"
        android:visibility="gone" />

</LinearLayout>