<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    tools:context=".MainActivity">

    <!-- Live camera, fills the space above the bottom panel. -->
    <androidx.camera.view.PreviewView
        android:id="@+id/previewView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toTopOf="@id/view"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0"
        app:scaleType="fillCenter" />

    <!-- Front cam fill light: soft white fade from each edge, 20% deep. Touches pass through. -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/fillGlow"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/previewView"
        app:layout_constraintEnd_toEndOf="@id/previewView"
        app:layout_constraintStart_toStartOf="@id/previewView"
        app:layout_constraintTop_toTopOf="@id/previewView">

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glowTopLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.2" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glowBottomLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            app:layout_constraintGuide_percent="0.8" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glowLeftLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.2" />

        <androidx.constraintlayout.widget.Guideline
            android:id="@+id/glowRightLine"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintGuide_percent="0.8" />

        <View
            android:id="@+id/glowTop"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sen_glow_v"
            app:layout_constraintBottom_toTopOf="@id/glowTopLine"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/glowBottom"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sen_glow_v"
            android:scaleY="-1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/glowBottomLine" />

        <View
            android:id="@+id/glowLeft"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sen_glow_h"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toStartOf="@id/glowLeftLine"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:id="@+id/glowRight"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/sen_glow_h"
            android:scaleX="-1"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/glowRightLine"
            app:layout_constraintTop_toTopOf="parent" />
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Bottom control panel: black with a thin navy edge along the top. -->
    <View
        android:id="@+id/view"
        android:layout_width="match_parent"
        android:layout_height="223dp"
        android:background="@color/black"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.0"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Phrase that was just spoken, at the top of the panel. -->
    <TextView
        android:id="@+id/captionText"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="3"
        android:paddingStart="20dp"
        android:paddingEnd="20dp"
        android:textColor="@color/white"
        android:textSize="24sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/view" />

    <!-- Logo, on a dark navy-rimmed chip so it stays readable over the camera. -->
    <ImageView
        android:id="@+id/imageView"
        android:layout_width="52dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:background="@drawable/bg_logo_chip"
        android:contentDescription="Logo"
        android:padding="8dp"
        android:scaleType="centerInside"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:srcCompat="@drawable/logo" />

    <!-- Button row. Every button is a navy circle with a white glyph, like the Text button. -->

    <ImageButton
        android:id="@+id/flipButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_sight_button"
        android:contentDescription="Flip camera"
        android:foreground="@drawable/fg_sight_ripple"
        android:padding="14dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/txtButton"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintStart_toStartOf="parent"
        app:srcCompat="@drawable/ic_flip_camera" />

    <ImageButton
        android:id="@+id/txtButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_sight_button"
        android:contentDescription="Text"
        android:foreground="@drawable/fg_sight_ripple"
        android:padding="11dp"
        android:scaleType="fitCenter"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/playButton"
        app:layout_constraintStart_toEndOf="@id/flipButton"
        app:srcCompat="@drawable/ic_txt" />

    <!-- Main action: slightly larger, with a white ring. -->
    <ImageButton
        android:id="@+id/playButton"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:layout_marginBottom="24dp"
        android:background="@drawable/bg_sight_button_primary"
        android:contentDescription="Record"
        android:foreground="@drawable/fg_sight_ripple"
        android:padding="20dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/folderButton"
        app:layout_constraintStart_toEndOf="@id/txtButton"
        app:srcCompat="@drawable/ic_play" />

    <ImageButton
        android:id="@+id/folderButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_sight_button"
        android:contentDescription="Files"
        android:foreground="@drawable/fg_sight_ripple"
        android:padding="14dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toStartOf="@id/muteButton"
        app:layout_constraintStart_toEndOf="@id/playButton"
        app:srcCompat="@drawable/ic_folder" />

    <ImageButton
        android:id="@+id/muteButton"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_marginBottom="32dp"
        android:background="@drawable/bg_sight_button"
        android:contentDescription="Mute"
        android:foreground="@drawable/fg_sight_ripple"
        android:padding="14dp"
        android:scaleType="centerInside"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/folderButton"
        app:srcCompat="@drawable/ic_volume_off" />


    <!-- Light button, above Flip camera -->
    <ImageButton
        android:id="@+id/lightButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginBottom="12dp"
        android:alpha="0.5"
        android:background="@drawable/bg_sight_button"
        android:contentDescription="Light"
        android:foreground="@drawable/fg_sight_ripple"

        android:scaleType="fitCenter"
        android:src="@drawable/flashlight3"
        app:layout_constraintBottom_toTopOf="@id/flipButton"
        app:layout_constraintEnd_toEndOf="@id/flipButton"
        app:layout_constraintStart_toStartOf="@id/flipButton" />

    <!-- Opens when the light button is tapped -->
    <LinearLayout
        android:id="@+id/lightMenu"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:visibility="gone"
        android:orientation="horizontal"

        app:layout_constraintBottom_toBottomOf="@id/lightButton"
        app:layout_constraintStart_toEndOf="@id/lightButton"
        app:layout_constraintTop_toTopOf="@id/lightButton">

        <TextView
            android:id="@+id/lightOff"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_sight_button"
            android:foreground="@drawable/fg_sight_ripple"
            android:gravity="center"
            android:text="Off"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lightAuto"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_sight_button"
            android:foreground="@drawable/fg_sight_ripple"
            android:gravity="center"
            android:text="Auto"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lightOn"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_sight_button"
            android:foreground="@drawable/fg_sight_ripple"
            android:gravity="center"
            android:text="On"
            android:textColor="@color/white"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>